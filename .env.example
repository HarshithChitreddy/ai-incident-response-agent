# Copy to .env and fill in. docker-compose reads this file automatically.

# LLM mock mode — defaults to true so real (billed) API calls never happen
# unless you explicitly set MOCK_LLM=false.
MOCK_LLM=true

# Required only when MOCK_LLM=false (real LLM analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Only needed when running the backend outside docker-compose
DATABASE_URL=postgresql+asyncpg://incident:incident@localhost:5432/incident_response

# Phase 5: leave empty to use the built-in Slack mock
SLACK_WEBHOOK_URL=
